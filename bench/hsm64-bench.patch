diff --git a/Makefile b/Makefile
index e590b59b..70a19640 100644
--- a/Makefile
+++ b/Makefile
@@ -69,6 +69,35 @@ endif
 
 DEFINES += NO_ERRNO_H=1
 
+# Trig benchmark (an external kit, not part of HackerSM64); see
+# src/engine/math_util.h. TRIG_FUNC: 0 none, 1 Silas, 2 BFSK (C); 4 Silas, 5 BFSK,
+# 6 BFSK with 4 loaded constants, 7 LUTX16, 8 quantized (assembly). TRIG_USE: 0 table
+# lookups, 1 calls. TRIG_QUANT=1 cuts a call's angle to the table's steps.
+# TRIG_COUNT=1 counts sins/coss calls. TRIG_SINCOS=1: in a call build,
+# sincoss() makes one trig_sincos call for both values. TRIG_SITES=1 reports
+# calls per call site (not for timing). TRIG_EMUX=0: a build for real
+# hardware, never runs the ares-only emux instructions (results on screen only).
+TRIG_BENCH ?= 0
+TRIG_FUNC  ?= 0
+TRIG_USE   ?= 0
+TRIG_QUANT ?= 1
+TRIG_COUNT ?= 0
+TRIG_SINCOS ?= 0
+TRIG_SITES ?= 0
+TRIG_EMUX  ?= 1
+# TRIG_CYCLES=1: at the end, also time each trig form per call with interrupts
+# off (warm cache; ares only). Its own builds: the code it adds moves the layout.
+TRIG_CYCLES ?= 0
+# TRIG_INLINE=1: with TRIG_SINCOS, sincoss() is the kernel as inline assembly
+# (src/engine/sincos_inline.h; TRIG_FUNC 5 or 8), no call.
+TRIG_INLINE ?= 0
+# TRIG_PAD: bytes of padding placed in the code before trig_sin, a layout
+# control that moves it and the code linked after it.
+TRIG_PAD   ?= 0
+ifeq ($(TRIG_BENCH),1)
+  DEFINES += TRIG_BENCH=1 TRIG_HSM64=1 TRIG_FUNC=$(TRIG_FUNC) TRIG_USE=$(TRIG_USE) TRIG_QUANT=$(TRIG_QUANT) TRIG_COUNT=$(TRIG_COUNT) TRIG_PAD=$(TRIG_PAD) TRIG_SINCOS=$(TRIG_SINCOS) TRIG_SITES=$(TRIG_SITES) TRIG_EMUX=$(TRIG_EMUX) TRIG_CYCLES=$(TRIG_CYCLES) TRIG_INLINE=$(TRIG_INLINE)
+endif
+
 # VERSION - selects the version of the game to build
 #   jp - builds the 1996 Japanese version
 #   us - builds the 1996 North American version
