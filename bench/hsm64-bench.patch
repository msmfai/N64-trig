diff --git a/src/engine/math_util.h b/src/engine/math_util.h
index f53e65e4..d295c9d2 100644
--- a/src/engine/math_util.h
+++ b/src/engine/math_util.h
@@ -38,10 +38,98 @@ extern Vec3s gVec3sOne;
 extern f32 gSineTable[];
 #define gCosineTable (gSineTable + 0x400)
 
-#define sins(x) gSineTable[  (u16) (x) >> 4]
-#define coss(x) gCosineTable[(u16) (x) >> 4]
+/*
+ * Trig benchmark (an external kit, not part of HackerSM64).
+ *   TRIG_FUNC  which sine src/game/trig_impl.c provides as trig_sin:
+ *              0 none, 1 Silas Lock's folded polynomial, 2 BFSK
+ *   TRIG_USE   0: sins/coss stay table lookups; 1: they call trig_sin
+ *   TRIG_QUANT 1: a call cuts its angle to the table's 4096 steps
+ *   TRIG_COUNT counts the calls (not for timing)
+ *   TRIG_SINCOS 1: sincoss() is one trig_sincos call (call builds only)
+ *   TRIG_INLINE 1: with TRIG_SINCOS, sincoss() is the kernel inline (no call)
+ *   TRIG_SITES reports calls per call site (not for timing)
+ *
+ * With TRIG_FUNC != 0 and TRIG_USE 0 the table is refilled at boot from
+ * trig_sin (trig_bench_init). That build and the TRIG_USE 1, TRIG_QUANT 1
+ * build then compute bit-identical values, so they play the same game and
+ * differ only in what a sine costs.
+ */
+#ifndef TRIG_FUNC
+#define TRIG_FUNC 0
+#endif
+#ifndef TRIG_USE
+#define TRIG_USE 0
+#endif
+#ifndef TRIG_QUANT
+#define TRIG_QUANT 1
+#endif
+#ifndef TRIG_COUNT
+#define TRIG_COUNT 0
+#endif
+#ifndef TRIG_SINCOS
+#define TRIG_SINCOS 0
+#endif
+#ifndef TRIG_SITES
+#define TRIG_SITES 0
+#endif
+
+#if TRIG_FUNC != 0
+f32 trig_sin(s32 angle);
+#endif
+
+#if TRIG_USE == 0
+#define TRIG_SIN_EXPR(x) gSineTable[  (u16) (x) >> 4]
+#define TRIG_COS_EXPR(x) gCosineTable[(u16) (x) >> 4]
+#elif TRIG_QUANT
+#define TRIG_SIN_EXPR(x) trig_sin((u16) (x) & 0xFFF0)
+#define TRIG_COS_EXPR(x) trig_sin(((u16) (x) & 0xFFF0) + 0x4000)
+#else
+#define TRIG_SIN_EXPR(x) trig_sin((u16) (x))
+#define TRIG_COS_EXPR(x) trig_sin((u16) (x) + 0x4000)
+#endif
+#if TRIG_SITES
+f32 trig_site(s32 angle);
+#undef TRIG_SIN_EXPR
+#undef TRIG_COS_EXPR
+#define TRIG_SIN_EXPR(x) trig_site((u16) (x) & 0xFFF0)
+#define TRIG_COS_EXPR(x) trig_site(((u16) (x) & 0xFFF0) + 0x4000)
+#endif
+
+#if TRIG_COUNT
+extern u32 gTrigCalls;
+#define sins(x) (gTrigCalls++, TRIG_SIN_EXPR(x))
+#define coss(x) (gTrigCalls++, TRIG_COS_EXPR(x))
+#else
+#define sins(x) TRIG_SIN_EXPR(x)
+#define coss(x) TRIG_COS_EXPR(x)
+#endif
+/* sincoss(angle, s, c): s = sins(angle), c = coss(angle). With TRIG_SINCOS
+ * in a call build, one trig_sincos call returns both (in $f0/$f2);
+ * otherwise it is the two macros. Values are identical either way. */
+#if TRIG_SINCOS && TRIG_USE && TRIG_FUNC != 0
+_Complex float trig_sincos(s32 angle);
+#if TRIG_QUANT
+#define TRIG_SC_ARG(x) ((u16) (x) & 0xFFF0)
+#else
+#define TRIG_SC_ARG(x) ((u16) (x))
+#endif
+#if TRIG_INLINE
+/* The kernel inline at each sincoss() site: no call (src/engine/sincos_inline.h). */
+#define SINCOS_INLINE_QUANTIZED (TRIG_FUNC == 8)
+#include "sincos_inline.h"
+#define sincoss(x, s, c) do { f32 _is, _ic; sincos_inline(TRIG_SC_ARG(x), &_is, &_ic); \
+    (s) = _is; (c) = _ic; } while (0)
+#else
+#define sincoss(x, s, c) do { _Complex float _sc = trig_sincos(TRIG_SC_ARG(x)); \
+    (s) = __real__ _sc; (c) = __imag__ _sc; } while (0)
+#endif
+#define tans(x) ({ f32 _ts, _tc; sincoss((x), _ts, _tc); _ts / _tc; })
+#define cots(x) ({ f32 _ts, _tc; sincoss((x), _ts, _tc); _tc / _ts; })
+#else
+#define sincoss(x, s, c) do { u16 _sa = (u16) (x); (s) = sins(_sa); (c) = coss(_sa); } while (0)
 #define tans(x) (sins(x) / coss(x))
 #define cots(x) (coss(x) / sins(x))
+#endif
 #define atans(x) gArctanTable[(s32)((((x) * 1024) + 0.5f))] // is this correct? used for atan2_lookup
 
